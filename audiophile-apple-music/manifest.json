{
    "name":  "audiophile-apple-music",
    "displayName":  "Apple Music",
    "version":  "1.3.8",
    "description":  "Apple Music metadata and lyrics provider for SpotiFLAC Mobile. Fetches ISRC, label, copyright, genre, composer. Lyrics require a Media User Token (Apple Music subscription).",
    "homepage":  "https://github.com/zarzet/SpotiFLAC-Mobile",
    "type":  [
                 "metadata_provider",
                 "lyrics_provider"
             ],
    "minAppVersion":  "4.2.3",
    "skipMetadataEnrichment":  true,
    "capabilities":  {
                         "homeFeed":  false,
                         "browseCategories":  false
                     },
    "permissions":  {
                        "network":  [
                                        "music.apple.com",
                                        "amp-api.music.apple.com",
                                        "*.mzstatic.com",
                                        "api.deezer.com"
                                    ],
                        "storage":  true,
                        "file":  true
                    },
    "searchBehavior":  {
                           "enabled":  true,
                           "placeholder":  "Search Apple Music...",
                           "icon":  "apple",
                           "thumbnailRatio":  "square",
                           "filters":  [
                                           {
                                               "id":  "tracks",
                                               "label":  "Songs",
                                               "icon":  "music"
                                           },
                                           {
                                               "id":  "albums",
                                               "label":  "Albums",
                                               "icon":  "album"
                                           },
                                           {
                                               "id":  "artists",
                                               "label":  "Artists",
                                               "icon":  "artist"
                                           },
                                           {
                                               "id":  "playlists",
                                               "label":  "Playlists",
                                               "icon":  "playlist"
                                           }
                                       ]
                       },
    "urlHandler":  {
                       "enabled":  true,
                       "patterns":  [
                                        "music.apple.com"
                                    ]
                   },
    "settings":  [
                     {
                         "key":  "storefront",
                         "label":  "Storefront / Region",
                         "type":  "string",
                         "default":  "us",
                         "description":  "Apple Music storefront code (e.g. us, gb, jp, id). Affects search results and catalog availability."
                     },
                     {
                         "key":  "mediaUserToken",
                         "label":  "Media User Token",
                         "type":  "string",
                         "default":  "",
                         "description":  "Required for lyrics. Get it from browser console on music.apple.com: MusicKit.getInstance().musicUserToken ??? Needs active Apple Music subscription."
                     },
                     {
                         "key":  "lyricsTranslation",
                         "label":  "Lyrics Translation Language",
                         "type":  "string",
                         "default":  "",
                         "description":  "Language code for translated lyrics (e.g. en, zh-Hans, ja, ko, id). Leave empty to disable. Uses Apple Music\u0027s built-in translations."
                     },
                     {
                         "key":  "lyricsPronunciation",
                         "label":  "Lyrics Pronunciation Language",
                         "type":  "string",
                         "default":  "",
                         "description":  "Language code for romanized pronunciation (e.g. ja-Latn for romaji, ko-Latn for Korean). Leave empty to disable."
                     }
                 ],
    "id":  "audiophile.apple-music"
}
