{
    "name":  "audiophile-tidal",
    "displayName":  "Tidal",
    "version":  "1.1.2",
    "description":  "TIDAL metadata and search provider for SpotiFLAC Mobile using TIDAL public web endpoints.",
    "homepage":  "https://github.com/zarzet/SpotiFLAC-Mobile",
    "type":  [
                 "metadata_provider",
                 "download_provider"
             ],
    "minAppVersion":  "4.7.0",
    "requiredRuntimeFeatures":  [
                                    "signedSession@1",
                                    "sessionGrant@1"
                                ],
    "signedSession":  {
                          "namespace":  "zarz-v2",
                          "baseUrl":  "https://api.zarz.moe/v2",
                          "appVersion":  "tidal-web@1.1.0",
                          "platform":  "extension",
                          "callbackUrl":  "spotiflac://session-grant",
                          "schemeLabel":  "ZARZ-HMAC-V1",
                          "headerPrefix":  "X-Zarz-",
                          "timeWindowSeconds":  300,
                          "endpoints":  {
                                            "bootstrap":  "/bootstrap",
                                            "challenge":  "/challenge",
                                            "exchange":  "/session/exchange",
                                            "refresh":  "/session/refresh"
                                        }
                      },
    "permissions":  {
                        "network":  [
                                        "tidal.com",
                                        "www.tidal.com",
                                        "listen.tidal.com",
                                        "resources.tidal.com",
                                        "api.zarz.moe",
                                        "*.audio.tidal.com",
                                        "*.manifest.tidal.com"
                                    ],
                        "storage":  true,
                        "file":  true
                    },
    "qualityOptions":  [
                           {
                               "id":  "DOLBY_ATMOS",
                               "label":  "Dolby Atmos",
                               "description":  "Try Dolby Atmos first, then fall back to Hi-Res, Lossless, and High"
                           },
                           {
                               "id":  "HI_RES_LOSSLESS",
                               "label":  "HiRes FLAC",
                               "description":  "Attempt TIDAL hi-res lossless, then fall back to Lossless and High"
                           },
                           {
                               "id":  "LOSSLESS",
                               "label":  "Lossless",
                               "description":  "Attempt TIDAL lossless quality, then fall back to High"
                           },
                           {
                               "id":  "HIGH",
                               "label":  "High",
                               "description":  "Fallback compressed TIDAL stream"
                           },
                           {
                               "id":  "LOW",
                               "label":  "Low",
                               "description":  "Lowest quality fallback"
                           }
                       ],
    "capabilities":  {
                         "downloadFallbackTier":  "lossless",
                         "requiresNativeContainerConversion":  true,
                         "replacesBuiltInProviders":  [
                                                          "tidal"
                                                      ],
                         "shareUrlTemplates":  {
                                                   "album":  "https://tidal.com/browse/album/{id}",
                                                   "artist":  "https://tidal.com/browse/artist/{id}"
                                               }
                     },
    "serviceHealth":  [
                          {
                              "id":  "zarz-api",
                              "label":  "Zarz API",
                              "url":  "https://api.zarz.moe/v1/health",
                              "method":  "GET",
                              "serviceKey":  "tidal",
                              "timeoutMs":  4000,
                              "cacheTtlSeconds":  60,
                              "required":  true
                          }
                      ],
    "searchBehavior":  {
                           "enabled":  true,
                           "primary":  false,
                           "placeholder":  "Search TIDAL...",
                           "thumbnailRatio":  "square",
                           "filters":  [
                                           {
                                               "id":  "track",
                                               "label":  "Songs",
                                               "icon":  "music"
                                           },
                                           {
                                               "id":  "album",
                                               "label":  "Albums",
                                               "icon":  "album"
                                           },
                                           {
                                               "id":  "artist",
                                               "label":  "Artists",
                                               "icon":  "artist"
                                           },
                                           {
                                               "id":  "playlist",
                                               "label":  "Playlists",
                                               "icon":  "playlist"
                                           }
                                       ]
                       },
    "urlHandler":  {
                       "enabled":  true,
                       "patterns":  [
                                        "tidal.com",
                                        "www.tidal.com",
                                        "listen.tidal.com",
                                        "tidal:"
                                    ]
                   },
    "settings":  [
                     {
                         "key":  "publicToken",
                         "label":  "Public Web Token",
                         "type":  "string",
                         "default":  "49YxDN9a2aFV6RTG",
                         "description":  "Public TIDAL web token used for metadata/search requests."
                     },
                     {
                         "key":  "countryCode",
                         "label":  "Country Code",
                         "type":  "string",
                         "default":  "US",
                         "description":  "Country code sent to TIDAL public endpoints."
                     },
                     {
                         "key":  "locale",
                         "label":  "Locale",
                         "type":  "string",
                         "default":  "en_US",
                         "description":  "Locale sent to TIDAL public endpoints."
                     },
                     {
                         "key":  "deviceType",
                         "label":  "Device Type",
                         "type":  "string",
                         "default":  "BROWSER",
                         "description":  "Device type sent to TIDAL public endpoints."
                     },
                     {
                         "key":  "downloadApiUrl",
                         "label":  "Download API URL",
                         "type":  "string",
                         "default":  "https://api.zarz.moe/v1/dl/tid2",
                         "description":  "Primary TIDAL download API used for Dolby Atmos and quality fallback."
                     }
                 ],
    "id":  "audiophile.tidal-web"
}
