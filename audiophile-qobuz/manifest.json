{
    "name":  "audiophile-qobuz",
    "displayName":  "Qobuz",
    "version":  "1.1.0",
    "description":  "Qobuz metadata and download provider for SpotiFLAC Mobile.",
    "homepage":  "https://github.com/zarzet/SpotiFLAC-Mobile",
    "type":  [
                 "metadata_provider",
                 "download_provider"
             ],
    "minAppVersion":  "4.7.0",
    "requiredRuntimeFeatures":  [
                                    "signedSession@1",
                                    "sessionGrant@1"
                                ],
    "signedSession":  {
                          "namespace":  "zarz-v2",
                          "baseUrl":  "https://api.zarz.moe/v2",
                          "appVersion":  "qobuz-web@1.1.0",
                          "platform":  "extension",
                          "callbackUrl":  "spotiflac://session-grant",
                          "schemeLabel":  "ZARZ-HMAC-V1",
                          "headerPrefix":  "X-Zarz-",
                          "timeWindowSeconds":  300,
                          "endpoints":  {
                                            "bootstrap":  "/bootstrap",
                                            "challenge":  "/challenge",
                                            "exchange":  "/session/exchange",
                                            "refresh":  "/session/refresh"
                                        }
                      },
    "permissions":  {
                        "network":  [
                                        "api.zarz.moe",
                                        "www.qobuz.com",
                                        "qobuz.com",
                                        "play.qobuz.com",
                                        "open.qobuz.com",
                                        "static.qobuz.com",
                                        "streaming-qobuz-std.akamaized.net"
                                    ],
                        "storage":  true,
                        "file":  true
                    },
    "qualityOptions":  [
                           {
                               "id":  "HI_RES_LOSSLESS",
                               "label":  "24-Bit Max",
                               "description":  "Attempt the highest Qobuz hi-res quality first"
                           },
                           {
                               "id":  "HI_RES",
                               "label":  "24-Bit",
                               "description":  "Prefer 24-bit Qobuz quality"
                           },
                           {
                               "id":  "LOSSLESS",
                               "label":  "Lossless",
                               "description":  "Fallback to standard Qobuz lossless quality"
                           }
                       ],
    "capabilities":  {
                         "downloadFallbackTier":  "lossless",
                         "replacesBuiltInProviders":  [
                                                          "qobuz"
                                                      ],
                         "shareUrlTemplates":  {
                                                   "album":  "https://play.qobuz.com/album/{id}",
                                                   "artist":  "https://play.qobuz.com/artist/{id}"
                                               }
                     },
    "serviceHealth":  [
                          {
                              "id":  "zarz-api",
                              "label":  "Zarz API",
                              "url":  "https://api.zarz.moe/v1/health",
                              "method":  "GET",
                              "serviceKey":  "qobuz",
                              "timeoutMs":  4000,
                              "cacheTtlSeconds":  60,
                              "required":  true
                          }
                      ],
    "searchBehavior":  {
                           "enabled":  true,
                           "primary":  false,
                           "placeholder":  "Search Qobuz...",
                           "thumbnailRatio":  "square",
                           "filters":  [
                                           {
                                               "id":  "track",
                                               "label":  "Songs",
                                               "icon":  "music"
                                           },
                                           {
                                               "id":  "album",
                                               "label":  "Albums",
                                               "icon":  "album"
                                           },
                                           {
                                               "id":  "artist",
                                               "label":  "Artists",
                                               "icon":  "artist"
                                           }
                                       ]
                       },
    "urlHandler":  {
                       "enabled":  true,
                       "patterns":  [
                                        "qobuz.com",
                                        "www.qobuz.com",
                                        "play.qobuz.com",
                                        "open.qobuz.com",
                                        "qobuzapp://",
                                        "qobuz:"
                                    ]
                   },
    "settings":  [
                     {
                         "key":  "apiBaseUrl",
                         "label":  "Primary Metadata API URL",
                         "type":  "string",
                         "default":  "https://api.zarz.moe/v1/qbz",
                         "description":  "Primary API used for Qobuz metadata and search."
                     },
                     {
                         "key":  "fallbackApiBaseUrl",
                         "label":  "Fallback Metadata API URL",
                         "type":  "string",
                         "default":  "https://api.zarz.moe/v1/qbz2",
                         "description":  "Fallback API used when the primary metadata API fails."
                     },
                     {
                         "key":  "appId",
                         "label":  "Qobuz App ID",
                         "type":  "string",
                         "default":  "798273057",
                         "description":  "App ID sent to the primary metadata API."
                     },
                     {
                         "key":  "countryCode",
                         "label":  "Country Code",
                         "type":  "string",
                         "default":  "US",
                         "description":  "Country code used for provider requests that require it."
                     }
                 ],
    "id":  "audiophile.qobuz-web"
}
